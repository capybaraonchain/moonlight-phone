#!/usr/bin/env python3
"""Paired phone window geometry, text-focus hints, typed text and clipboard text.

Never mouse emulation, output management, logging of request bodies or a shell
fed with client input. Text from the phone keyboard is typed through a virtual
keyboard, so it is independent of the desktop keyboard layout."""
import argparse
from contextlib import contextmanager
import fcntl
import hashlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import math
import os
from pathlib import Path
import re
import secrets
import socket
import ssl
import struct
import subprocess
import threading
import time

class Rejected(Exception):
    pass

CLIPBOARD_LIMIT = 256*1024
# Terminal emulators have no accessible "editable" field; a tap inside one
# still wants the keyboard, without autocorrect or capitalisation.
TERMINALS = re.compile(r'(?i)(^|[.\-_])(ghostty|alacritty|kitty|foot|footclient|wezterm|ptyxis|konsole|xterm|console|terminal|kgx|tui)([.\-_]|$)')

def read(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {}

# Ordinary printable key positions (evdev codes): the digit row and the three
# letter rows. Characters are only ever placed here; Backspace, Tab and Return
# keep their real positions, because Chromium decides what some keys mean from
# their position, not from the symbol the keymap gives them.
TYPIST_SLOTS = [*range(2, 14), *range(16, 28), *range(30, 42), *range(43, 54)]
TYPIST_KEYS = {'\b': (14, 'BackSpace'), '\t': (15, 'Tab'), '\n': (28, 'Return')}


class Typist:
    """One short-lived Wayland client that types a sequence, then goes away."""

    def __init__(self, env):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(2)
        self.sock.connect(os.path.join(env['XDG_RUNTIME_DIR'], env.get('WAYLAND_DISPLAY', 'wayland-1')))
        self.ids = 1
        self.pending = b''
        registry = self.new_id()
        self.send(1, 1, struct.pack('<I', registry))
        found = {}

        def on_global(obj, opcode, data):
            if obj == registry and opcode == 0:
                name, size = struct.unpack_from('<II', data)
                found[data[8:8 + size - 1].decode()] = name

        self.roundtrip(on_global)
        if 'wl_seat' not in found or 'zwp_virtual_keyboard_manager_v1' not in found:
            raise OSError('The compositor has no virtual keyboard')
        self.seat, self.manager, self.keyboard = self.new_id(), self.new_id(), None
        self.bind(registry, found['wl_seat'], 'wl_seat', self.seat)
        self.bind(registry, found['zwp_virtual_keyboard_manager_v1'], 'zwp_virtual_keyboard_manager_v1', self.manager)

    def new_id(self):
        self.ids += 1
        return self.ids

    def send(self, obj, opcode, payload=b'', fds=()):
        message = struct.pack('<II', obj, (8 + len(payload)) << 16 | opcode) + payload
        if fds:
            socket.send_fds(self.sock, [message], list(fds))
        else:
            self.sock.sendall(message)

    def bind(self, registry, name, interface, new):
        text = interface.encode() + b'\0'
        text += b'\0' * (-len(text) % 4)
        self.send(registry, 0, struct.pack('<II', name, len(interface) + 1) + text + struct.pack('<II', 1, new))

    def roundtrip(self, handler=None):
        # wl_display.sync: everything sent before it has been handled once its
        # callback fires. A protocol error arrives as an event on the display.
        callback = self.new_id()
        self.send(1, 0, struct.pack('<I', callback))
        while True:
            while len(self.pending) < 8 or len(self.pending) < struct.unpack_from('<I', self.pending, 4)[0] >> 16:
                data = self.sock.recv(65536)
                if not data:
                    raise OSError('The compositor closed the connection')
                self.pending += data
            obj, word = struct.unpack_from('<II', self.pending)
            size, opcode = word >> 16, word & 0xffff
            body, self.pending = self.pending[8:size], self.pending[size:]
            if obj == 1 and opcode == 0:
                raise OSError('The compositor refused the virtual keyboard')
            if obj == callback:
                return
            if handler:
                handler(obj, opcode, body)

    def keymap(self, slots):
        # A keymap is honoured once per virtual keyboard, so every batch of
        # characters gets a fresh keyboard carrying its complete keymap.
        if self.keyboard:
            self.send(self.keyboard, 3)
        self.keyboard = self.new_id()
        self.send(self.manager, 0, struct.pack('<II', self.seat, self.keyboard))
        codes = {code: name for code, name in TYPIST_KEYS.values()}
        codes.update({code: 'U%04X' % ord(char) for char, code in slots.items()})
        text = ('xkb_keymap {\nxkb_keycodes "phone" { minimum = 8; maximum = 255;\n'
                + ''.join(f'<K{c + 8}> = {c + 8};\n' for c in codes)
                + '};\nxkb_types "phone" { include "complete" };\n'
                'xkb_compatibility "phone" { include "complete" };\nxkb_symbols "phone" {\n'
                + ''.join(f'key <K{c + 8}> {{ [ {name} ] }};\n' for c, name in codes.items())
                + '};\n};\n').encode() + b'\0'
        fd = os.memfd_create('phone-keymap')
        try:
            os.write(fd, text)
            # format 1 is XKB v1; the descriptor travels beside the message.
            self.send(self.keyboard, 0, struct.pack('<II', 1, len(text)), [fd])
        finally:
            os.close(fd)
        self.send(self.keyboard, 2, struct.pack('<IIII', 0, 0, 0, 0))

    def type(self, sequence):
        batch, slots = [], {}
        for char in [*sequence, None]:
            full = char is not None and char not in TYPIST_KEYS and char not in slots and len(slots) == len(TYPIST_SLOTS)
            if (char is None or full) and batch:
                self.keymap(slots)
                for code in batch:
                    stamp = int(time.monotonic() * 1000) & 0xffffffff
                    self.send(self.keyboard, 1, struct.pack('<III', stamp, code, 1))
                    self.send(self.keyboard, 1, struct.pack('<III', stamp, code, 0))
                self.roundtrip()
                # An input method relays these keys onward with this keymap;
                # replacing or removing the keyboard sooner loses them.
                time.sleep(.03 + .0005 * len(batch))
                batch, slots = [], {}
            if char is None:
                break
            if char in TYPIST_KEYS:
                batch.append(TYPIST_KEYS[char][0])
            else:
                batch.append(slots.setdefault(char, TYPIST_SLOTS[len(slots)]))

    def close(self):
        try:
            if self.keyboard:
                self.send(self.keyboard, 3)
            self.roundtrip()
        except OSError:
            pass
        self.sock.close()

class Desktop:
    def __init__(self, root, env=None):
        self.root = Path(root)
        self.env = dict(os.environ if env is None else env)
        self.signature = self.env.get('HYPRLAND_INSTANCE_SIGNATURE', '')
        if not self.signature:
            raise RuntimeError('Missing compositor identity')
        self.path = Path(self.env['XDG_RUNTIME_DIR'])/'hypr'/self.signature/'.socket.sock'
        if self.path.is_symlink() or self.path.stat().st_uid != os.getuid():
            raise RuntimeError('Compositor socket ownership mismatch')
        self.gestures = {}
        self.mutex = threading.Lock()

    def command(self, text, json_result=False):
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(2)
            sock.connect(str(self.path))
            sock.sendall((('j/' if json_result else '/') + text).encode())
            chunks = []
            size = 0
            while data := sock.recv(65536):
                size += len(data)
                if size > 4*1024*1024:
                    raise Rejected('Compositor response too large')
                chunks.append(data)
        result = b''.join(chunks).decode()
        if json_result:
            return json.loads(result)
        if result.strip() != 'ok':
            raise Rejected('The window manager could not apply this change')

    @contextmanager
    def display_lock(self):
        with (self.root/'mac-mode/lock').open('a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise Rejected('The display is changing. Try again after rotation.')
            yield

    def context(self):
        session = read(self.root/'phone-mode/session.json')
        if session.get('instance') != self.signature or not session.get('nonce'):
            raise Rejected('Window controls are available during a phone stream')
        monitors = self.command('monitors', True)
        monitor = next((m for m in monitors if m['name'] == 'MAC-MODE' and m.get('mirrorOf', 'none') in ('none','')), None)
        if not monitor:
            raise Rejected('The phone desktop is no longer active')
        stamp = (session['nonce'], session.get('mode'), session.get('scale'), monitor['width'], monitor['height'], monitor['scale'])
        return stamp, monitor

    @staticmethod
    def eligible(w):
        return (w.get('mapped') and not w.get('hidden') and w.get('workspace',{}).get('name') == '1'
            and w.get('class') != 'capy.agent-native' and not w.get('class','').startswith('capy.agent-')
            and re.fullmatch(r'0x[0-9a-fA-F]+', w.get('address','')) and w.get('pid',0) > 0)

    def bounds(self, monitor):
        left, top, right, bottom = monitor.get('reserved', [0,0,0,0])
        # Hyprland reports the client rectangle: the native frame extends above it.
        height = self.command('getoption plugin:hyprbars:bar_height', True).get('int',30)
        margin = max(0,min(int(height),96)) + 2
        x = monitor['x'] + left + 2
        y = monitor['y'] + top + margin
        endx = monitor['x'] + round(monitor['width']/monitor['scale']) - right - 2
        endy = monitor['y'] + round(monitor['height']/monitor['scale']) - bottom - 2
        return x,y,max(x+1,endx),max(y+1,endy)

    @staticmethod
    def fit(frame, bounds):
        x,y,w,h = frame
        left,top,right,bottom = bounds
        # Floating means the frame may be larger than the screen or overlap its
        # edges. Retain a reachable titlebar, not a forced full-window fit.
        w = min(max(160,w),max(160,(right-left)*4))
        h = min(max(120,h),max(120,(bottom-top)*4))
        return tuple(round(n) for n in (max(left-w+96,min(x,right-96)),max(top,min(y,bottom-32)),w,h))

    def settle(self, window, requested, bounds):
        # Toolkit constraints arrive with the next surface commit. Read them back
        # so an app refusing a smaller size cannot recenter its titlebar offscreen.
        time.sleep(.025)
        current = next((w for w in self.command('clients',True) if w['address']==window['address'] and w['pid']==window['pid']),None)
        if not current or not self.eligible(current):
            raise Rejected('The selected window closed or changed desktop')
        w,h = current['size']
        left,top,right,bottom = bounds
        x = round(max(left-w+96,min(requested[0],right-96)))
        y = round(max(top,min(requested[1],bottom-32)))
        if current['at'] != [x,y]:
            self.command('eval hl.dispatch(hl.dsp.window.move({window='+json.dumps('address:'+current['address'])+f',x={x},y={y},relative=false}}))')
        return x,y,w,h

    def apply(self, window, frame):
        x,y,w,h = frame
        selector = json.dumps('address:'+window['address'])
        ops = []
        if window['size'] != [w,h]:
            ops.append(f'hl.dispatch(hl.dsp.window.resize({{window={selector},x={w},y={h},relative=false}}))')
        # Hyprland may center a resize; re-anchor even when the old position matched.
        if ops or window['at'] != [x,y]:
            ops.append(f'hl.dispatch(hl.dsp.window.move({{window={selector},x={x},y={y},relative=false}}))')
        if ops:
            self.command('eval ' + ';'.join(ops))

    def terminal(self, window):
        # Omarchy tags its terminal windows; the class list covers the rest.
        tags = {str(t).rstrip('*') for t in window.get('tags',[])}
        return 'terminal' in tags or bool(TERMINALS.search(str(window.get('class',''))))

    def clipboard(self, request):
        # Plain text only, and only while this compositor is on the phone display.
        self.context()
        op = request.get('op')
        if op == 'set':
            text = request.get('text')
            if type(text) != str or not text or '\x00' in text:
                raise Rejected('Nothing to paste')
            data = text.encode()
            if len(data) > CLIPBOARD_LIMIT:
                raise Rejected('That text is too long to send to the desktop')
            try:
                # wl-copy keeps serving the selection from a detached child.
                done = subprocess.run(['wl-copy','--type','text/plain;charset=utf-8'],input=data,env=self.env,
                    stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=2)
            except (OSError,subprocess.TimeoutExpired):
                raise Rejected('The desktop clipboard is unavailable')
            if done.returncode != 0:
                raise Rejected('The desktop clipboard is unavailable')
            # The hash lets the phone recognise this text as its own later.
            return {'ok':True,'terminal':self.terminal(self.command('activewindow',True)),'hash':hashlib.sha256(data).hexdigest()}
        if op not in ('get','hash'):
            raise Rejected('Unknown operation')
        try:
            kinds = subprocess.run(['wl-paste','--list-types'],env=self.env,capture_output=True,text=True,timeout=1.5)
            types = kinds.stdout.split() if kinds.returncode == 0 else []
            # Password managers flag secrets; never forward those.
            if not any(t.startswith('text/') or t in ('UTF8_STRING','STRING','TEXT') for t in types) or 'x-kde-passwordManagerHint' in types:
                return {'ok':True,'empty':True}
            paste = subprocess.run(['wl-paste','--no-newline','--type','text'],env=self.env,capture_output=True,timeout=1.5)
        except (OSError,subprocess.TimeoutExpired):
            raise Rejected('The desktop clipboard is unavailable')
        data = paste.stdout
        if paste.returncode != 0 or not data:
            return {'ok':True,'empty':True}
        if len(data) > CLIPBOARD_LIMIT:
            raise Rejected('The desktop clipboard is too large to copy to the phone')
        digest = hashlib.sha256(data).hexdigest()
        if op == 'hash' or request.get('known') == digest:
            return {'ok':True,'hash':digest,'changed':False}
        return {'ok':True,'hash':digest,'changed':True,'text':data.decode('utf-8','replace')}

    def text(self, request):
        # The phone keyboard's edits since its last report: remove `delete`
        # characters before the caret, then type `text`. The virtual keyboard
        # carries its own keymap, so accents and symbols arrive intact whatever
        # layout the desktop uses. (Chromium cannot take characters beyond the
        # Basic Multilingual Plane, such as emoji, from any keyboard.)
        self.context()
        delete,text = request.get('delete',0),request.get('text','')
        if type(delete) != int or not 0 <= delete <= 2000 or type(text) != str or len(text) > 8000:
            raise Rejected('Invalid text')
        if any((ord(c) < 32 and c not in '\n\t') or ord(c) == 127 for c in text):
            raise Rejected('Invalid text')
        if not delete and not text:
            return {'ok':True}
        if not self.eligible(self.command('activewindow',True)):
            raise Rejected('Tap a desktop app first')
        typist = None
        try:
            typist = Typist(self.env)
            typist.type('\b'*delete + text)
        except (OSError,KeyError,struct.error):
            raise Rejected('Typing is unavailable')
        finally:
            if typist: typist.close()
        return {'ok':True}

    def chrome(self, request):
        value = request.get('toolbar')
        if value not in ('hidden','visible'):
            raise Rejected('Unknown operation')
        self.context()
        try:
            # The display helper owns the shared lock and the reservation.
            done = subprocess.run([str(Path(__file__).with_name('omarchy-phone-mode')),'toolbar',value],env=self.env,
                stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=8)
        except (OSError,subprocess.TimeoutExpired):
            raise Rejected('The display is changing. Try again after rotation.')
        if done.returncode != 0:
            raise Rejected('Window controls are available during a phone stream')
        return {'ok':True}

    def handle(self, request, peer):
        if not isinstance(request, dict):
            raise Rejected('Invalid request')
        direct = {'clipboard':self.clipboard,'chrome':self.chrome,'text':self.text}.get(request.get('action'))
        if direct:
            with self.mutex:
                return direct(request)
        with self.mutex, self.display_lock():
            now = time.monotonic()
            self.gestures = {k:g for k,g in self.gestures.items() if g['expires'] > now}
            action = request.get('action')
            if action == 'end' and 'seq' not in request:
                g = self.gestures.get(request.get('token',''))
                if g and g['peer'] == peer:
                    self.gestures.pop(request['token'])
                return {'ok':True}
            stamp, monitor = self.context()
            if action == 'context':
                # For the manual Type button: which keyboard suits the active app.
                w=self.command('activewindow',True)
                terminal=self.eligible(w) and self.terminal(w)
                return {'ok':True,'plain':terminal,'terminal':terminal}
            if action == 'focus':
                x,y=request.get('x'),request.get('y')
                if any(type(v) not in (int,float) or not math.isfinite(v) or not 0<=v<=1 for v in (x,y)):
                    raise Rejected('Invalid touch position')
                w=self.command('activewindow',True)
                if not self.eligible(w): return {'ok':True,'editable':False}
                point=[monitor['x']+x*monitor['width']/monitor['scale'],monitor['y']+y*monitor['height']/monitor['scale']]
                if self.terminal(w):
                    inside=w['at'][0]<=point[0]<=w['at'][0]+w['size'][0] and w['at'][1]<=point[1]<=w['at'][1]+w['size'][1]
                    return {'ok':True,'editable':inside,'plain':True,'terminal':True}
                payload={'window':{k:w[k] for k in ('pid','at','size')},'point':point}
                try:
                    probe=Path(__file__).with_name('omarchy-phone-focus')
                    r=subprocess.run([str(probe),json.dumps(payload)],env=self.env,capture_output=True,text=True,timeout=.85)
                    found=json.loads(r.stdout) if r.returncode==0 else {}
                    editable,plain=bool(found.get('editable')),bool(found.get('plain'))
                except (OSError,ValueError,subprocess.TimeoutExpired): editable=plain=False
                current=self.command('activewindow',True)
                if self.context()[0]!=stamp or current.get('address')!=w['address'] or current.get('pid')!=w['pid']:
                    editable=False
                return {'ok':True,'editable':editable,'plain':editable and plain}
            if action == 'begin':
                mode = request.get('mode')
                if mode not in ('move','resize'):
                    raise Rejected('Choose Move or Resize')
                w = self.command('activewindow',True)
                if not self.eligible(w):
                    raise Rejected('Tap a desktop app first, then choose Move or Resize')
                selector = json.dumps('address:'+w['address'])
                if w.get('fullscreen'):
                    self.command('eval hl.dispatch(hl.dsp.window.fullscreen({window='+selector+',mode="maximized",action="unset"}));hl.dispatch(hl.dsp.window.fullscreen({window='+selector+',mode="fullscreen",action="unset"}))')
                if not w.get('floating'):
                    self.command('eval hl.dispatch(hl.dsp.window.float({window='+selector+',action="on"}))')
                # Query again after restoring the normal rectangle, without a focus change.
                current = next((c for c in self.command('clients',True) if c['address']==w['address'] and c['pid']==w['pid']),None)
                if not current or not self.eligible(current):
                    raise Rejected('The selected window closed')
                frame = self.fit((*current['at'], *current['size']),self.bounds(monitor))
                self.apply(current,frame)
                frame = self.settle(current,frame,self.bounds(monitor))
                token = secrets.token_urlsafe(24)
                self.gestures = {token:{'peer':peer,'stamp':stamp,'address':w['address'],'pid':w['pid'],
                    'frame':frame,'mode':mode,'seq':-1,'expires':now+120,'delta':(0,0)}}
                return {'ok':True,'token':token,'width':monitor['width']/monitor['scale'],
                    'height':monitor['height']/monitor['scale']}
            if action not in ('update','end'):
                raise Rejected('Unknown operation')
            g = self.gestures.get(request.get('token',''))
            if not g or g['peer'] != peer or g['stamp'] != stamp:
                raise Rejected('Select the window again after changing display mode')
            seq = request.get('seq')
            if type(seq) != int or not 0 <= seq < 2**53:
                raise Rejected('Invalid update number')
            if seq <= g['seq']:
                return {'ok':True,'dx':g['delta'][0],'dy':g['delta'][1]}
            dx,dy = request.get('dx'),request.get('dy')
            if any(type(n) not in (int,float) or not math.isfinite(n) or abs(n)>100000 for n in (dx,dy)):
                raise Rejected('Invalid finger movement')
            window = next((c for c in self.command('clients',True) if c['address']==g['address'] and c['pid']==g['pid']),None)
            if not window or not self.eligible(window):
                self.gestures.pop(request['token'],None)
                raise Rejected('The selected window is no longer on this desktop')
            x,y,w,h = g['frame']
            frame = (x+dx,y+dy,w,h) if g['mode']=='move' else (x,y,w+dx,h+dy)
            # Keep the top-left stable while allowing sizes beyond the work area.
            bounds = self.bounds(monitor)
            frame = self.fit(frame,bounds)
            self.apply(window,frame)
            requested = frame
            frame = self.settle(window,frame,bounds)
            g.update(seq=seq, expires=now+120, delta=(frame[0]-x,frame[1]-y) if g['mode']=='move' else (frame[2]-w,frame[3]-h))
            response = {'ok':True,'dx':g['delta'][0],'dy':g['delta'][1],
                'limited':g['mode']=='resize' and (frame[2]>requested[2]+2 or frame[3]>requested[3]+2)}
            if action=='end':
                self.gestures.pop(request['token'])
            return response

class Pairing:
    def __init__(self, state, cert, key):
        self.state,self.cert,self.key = Path(state),str(cert),str(key)
        self.lock = threading.Lock()
        self.version = None
        self.context = None
        self.peers = set()

    def refresh(self):
        with self.lock:
            try:
                version = (self.state.stat().st_mtime_ns,self.state.stat().st_size)
            except OSError:
                version = None
            if version == self.version and self.context:
                return
            certs=[]
            for device in read(self.state).get('root',{}).get('named_devices',[]):
                if str(device.get('enabled','true')).lower()!='true':
                    continue
                certs.append(device['cert'])
            context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
            context.minimum_version = ssl.TLSVersion.TLSv1_2
            context.load_cert_chain(self.cert,self.key)
            context.verify_mode = ssl.CERT_REQUIRED
            context.verify_flags = ssl.VERIFY_X509_PARTIAL_CHAIN | ssl.VERIFY_X509_TRUSTED_FIRST
            if certs:
                context.load_verify_locations(cadata='\n'.join(certs))
            peers = {hashlib.sha256(ssl.PEM_cert_to_DER_cert(c)).hexdigest() for c in certs}
            self.context,self.peers,self.version = context,peers,version

    def authenticate(self, binary_cert):
        self.refresh()
        peer = hashlib.sha256(binary_cert or b'').hexdigest()
        if peer not in self.peers:
            raise Rejected('Client is not paired with Sunshine')
        return peer

class Handler(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'
    def log_message(self,*args):
        pass  # Never log credentials, request bodies, tokens or window titles.

    def do_POST(self):
        try:
            if self.path != '/phone/window':
                raise Rejected('Unknown endpoint')
            peer = self.server.pairing.authenticate(self.connection.getpeercert(binary_form=True))
            length = int(self.headers.get('Content-Length','0'))
            if not 0<length<=4*CLIPBOARD_LIMIT or self.headers.get('Transfer-Encoding'):
                raise Rejected('Invalid request size')
            request = json.loads(self.rfile.read(length))
            response = self.server.desktop.handle(request,peer)
            status = 200
        except (Rejected,ValueError,KeyError) as error:
            response,status = {'ok':False,'error':str(error)},409
        except Exception:
            response,status = {'ok':False,'error':'Window controls are temporarily unavailable'},503
        data = json.dumps(response,allow_nan=False).encode()
        self.send_response(status)
        self.send_header('Content-Type','application/json')
        self.send_header('Content-Length',str(len(data)))
        self.send_header('Cache-Control','no-store')
        if status != 200:
            self.send_header('Connection','close')
            self.close_connection = True
        self.end_headers()
        self.wfile.write(data)

class Server(ThreadingHTTPServer):
    daemon_threads = True
    address_family = socket.AF_INET6
    allow_reuse_address = True
    def get_request(self):
        sock,address = super().get_request()
        sock.settimeout(3)
        try:
            self.pairing.refresh()
            sock = self.pairing.context.wrap_socket(sock,server_side=True)
            sock.settimeout(10)
            sock.setsockopt(socket.IPPROTO_TCP,socket.TCP_NODELAY,1)
            return sock,address
        except Exception:
            sock.close()
            raise

    def handle_error(self,request,client_address):
        pass

def main():
    home=Path.home()
    parser=argparse.ArgumentParser()
    parser.add_argument('--port',type=int,default=47992)
    parser.add_argument('--bind',default='::')
    parser.add_argument('--state-root',type=Path,default=home/'.local/state/omarchy')
    parser.add_argument('--sunshine',type=Path,default=home/'.config/sunshine')
    args=parser.parse_args()
    desktop=Desktop(args.state_root)
    pairing=Pairing(args.sunshine/'sunshine_state.json',args.sunshine/'credentials/cacert.pem',args.sunshine/'credentials/cakey.pem')
    pairing.refresh()
    server=Server((args.bind,args.port),Handler)
    server.pairing,server.desktop=pairing,desktop
    print('Phone window controls ready (paired TLS)',flush=True)
    server.serve_forever()

if __name__=='__main__':
    main()
