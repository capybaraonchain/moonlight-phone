#!/usr/bin/env python3
"""Read only editable focus, role, geometry and caret position; never names,
text, values or keys."""
import json,sys,time
import gi
gi.require_version('Atspi','2.0')
from gi.repository import Atspi

def editable_at(w,point):
    Atspi.set_timeout(120,120)
    desktop=Atspi.get_desktop(0)
    deadline=time.monotonic()+.55
    budget=700
    for i in range(desktop.get_child_count()):
        app=desktop.get_child_at_index(i)
        if app.get_process_id()!=w['pid']: continue
        stack=[(app,0,None)]
        try:
            collection=app.get_collection_iface()
            if collection:
                states=Atspi.StateSet.new([Atspi.StateType.FOCUSED,Atspi.StateType.EDITABLE])
                rule=Atspi.MatchRule.new(states,Atspi.CollectionMatchType.ALL,{},Atspi.CollectionMatchType.ALL,[],Atspi.CollectionMatchType.ALL,[],Atspi.CollectionMatchType.ALL,False)
                matches=collection.get_matches(rule,Atspi.CollectionSortOrder.CANONICAL,1,True)
                if matches:
                    node=matches[0];parent=node;frame=None
                    for _ in range(28):
                        if not parent: break
                        if parent.get_role() in (Atspi.Role.FRAME,Atspi.Role.WINDOW):
                            c=parent.get_component_iface()
                            if c:
                                r=c.get_extents(Atspi.CoordType.SCREEN)
                                if r.width>0 and r.height>0: frame=(r.x,r.y,r.width,r.height)
                            break
                        parent=parent.get_parent()
                    stack=[(node,0,frame)]
        except Exception: pass
        while stack and budget>0 and time.monotonic()<deadline:
            node,depth,frame=stack.pop();budget-=1
            try:
                states=node.get_state_set()
                if states.contains(Atspi.StateType.DEFUNCT): continue
                role=node.get_role()
                if role in (Atspi.Role.FRAME,Atspi.Role.WINDOW):
                    c=node.get_component_iface()
                    if c:
                        r=c.get_extents(Atspi.CoordType.SCREEN)
                        if r.width>0 and r.height>0: frame=(r.x,r.y,r.width,r.height)
                if states.contains(Atspi.StateType.FOCUSED) and states.contains(Atspi.StateType.EDITABLE):
                    c=node.get_component_iface()
                    if not c: return False,False,False
                    r=c.get_extents(Atspi.CoordType.SCREEN)
                    x,y=point
                    # Some toolkits report physical coordinates. Anchor to the
                    # accessible top-level frame and the compositor client rect.
                    if frame:
                        fx,fy,fw,fh=frame;ww,wh=w['size'];wx,wy=w['at']
                        sx,sy=fw/max(1,ww),fh/max(1,wh)
                        if .8<sx<4.2 and .8<sy<4.2 and abs(sx-sy)<.25:
                            x=fx+(x-wx)*sx;y=fy+(y-wy)*sy
                    # Passwords and terminals want a plain keyboard: no autocorrect.
                    plain=role in (Atspi.Role.PASSWORD_TEXT,Atspi.Role.TERMINAL)
                    # A caret at the very start means new text begins here, so
                    # the phone keyboard may capitalise. Position only: the
                    # field's contents are not requested.
                    start=False
                    try:
                        t=node.get_text_iface()
                        start=bool(t) and t.get_caret_offset()==0
                    except Exception: pass
                    return (r.width>0 and r.height>0 and r.x-4<=x<=r.x+r.width+4 and r.y-4<=y<=r.y+r.height+4),plain,start
                if depth<28:
                    for k in range(min(node.get_child_count(),250)-1,-1,-1):
                        child=node.get_child_at_index(k)
                        if child: stack.append((child,depth+1,frame))
            except Exception: continue
    return False,False,False

if __name__=='__main__':
    try:
        request=json.loads(sys.argv[1]);result,plain,start=editable_at(request['window'],request['point'])
    except Exception: result=plain=start=False
    print(json.dumps({'editable':bool(result),'plain':bool(result and plain),'start':bool(result and start)}))
